# Needs R16 ("OSC") shorted
set_io -nowarn clk12 20

set_io -nowarn led_green 39
set_io -nowarn led_blue  40
set_io -nowarn led_red   41

set_io -nowarn -pullup yes flash_csn 16
set_io -nowarn flash_sck  15
set_io -nowarn flash_mosi 14
set_io -nowarn flash_miso 17

set_io -nowarn uart_tx 2
set_io -nowarn uart_rx 46

# Pin 44 is a global-buffer input
set_io -nowarn link_sck   44
set_io -nowarn link_mosi  45
set_io -nowarn link_miso  47
set_io -nowarn link_cs_n  48
set_io -nowarn fpga_irq_n 4
set_io -nowarn usb_pu  13
set_io -nowarn usb_dp  19
set_io -nowarn usb_dn  18

# LPC. Pin 35 can't be used while the PLL runs.
set_io -nowarn lpc_reset_n   32
set_io -nowarn lpc_frame_n   31
set_io -nowarn lpc_clk       37   # global-buffer input
set_io -nowarn lpc_lad[0]    34
set_io -nowarn lpc_lad[1]    43
set_io -nowarn lpc_lad[2]    36
set_io -nowarn lpc_lad[3]    42
set_io -nowarn v33_sense     38
# LFRAME# MOSFET gate, the same signal on all four
set_io -nowarn lframe_gate[0] 31
set_io -nowarn lframe_gate[1] 25
set_io -nowarn lframe_gate[2] 26
set_io -nowarn lframe_gate[3] 27
set_io -nowarn lframe_sense  23
