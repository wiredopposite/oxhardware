# UPduino v3.1 pin map (all designs; unused names are ignored via -nowarn)
# Source: tinyvision-ai-inc/UPduino-v3.0 RTL/common/upduino.pcf
# Header labels on the board are the FPGA package pin numbers ("gpio_N" = pin N).

# 12 MHz oscillator -> IOB_25B_G3 (global). Requires R16 ("OSC") shorted.
set_io -nowarn clk12 20

# On-board RGB LED (dedicated current-sink pins, driven via SB_RGBA_DRV)
set_io -nowarn led_green 39
set_io -nowarn led_blue  40
set_io -nowarn led_red   41

# Config flash chip select: keep the flash deselected while not in use
set_io -nowarn flash_csn 16

# Bring-up UART (Raspberry Pi Debug Probe "U" port, 3.3 V)
#   FPGA TX gpio_2  -> probe RX (yellow)
#   FPGA RX gpio_46 <- probe TX (orange)
set_io -nowarn uart_tx 2
set_io -nowarn uart_rx 46

# Xbox LPC, passive probe (left header, contiguous run 32..38, skipping 35). Inputs only.
# Series resistors: 33-220 ohm on LCLK/LAD/LFRAME#/LRESET#; 3.3 V sense via 10 k series
# plus 100 k pull-down to GND at the FPGA pin (iCE40 has no internal pull-downs).
# Power the UPduino (USB) before the Xbox, and switch the Xbox off first.
# Pin 35 is NOT usable while the PLL is in use (shares the PLL output I/O site).
set_io -nowarn lpc_reset_n   32
set_io -nowarn -pullup yes lpc_frame_n 31   # pulled up: reads idle if not connected (1.3-1.5 header has no LFRAME#)
set_io -nowarn lpc_clk       37   # IOT_45a_G1, global-capable
set_io -nowarn lpc_lad[0]    34
set_io -nowarn lpc_lad[1]    43
set_io -nowarn lpc_lad[2]    36
set_io -nowarn lpc_lad[3]    42
set_io -nowarn v33_sense     38
